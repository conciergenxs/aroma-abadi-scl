# Build-time flags. Copy to .env.local and set what you need:
#   cp .env.example .env.local
#
# These are read by src/lib/feature-flags.ts at BUILD time, not runtime, so
# restart the dev server after changing them.
#
# One codebase, one branch (main), three Vercel projects. The sites differ
# only by which of these is set on the project — there is no "lite branch"
# and no "company branch":
#
#   aroma-abadi-scl.vercel.app         nothing set        full workspace
#   aroma-abadi-scl-lite.vercel.app    VITE_LITE_MODE=1   reduced features
#   aroma-abadi-company.vercel.app     VITE_PUBLIC_SITE=1 public company page
#
# So to reproduce https://aroma-abadi-scl-lite.vercel.app locally, pull main
# and set VITE_LITE_MODE=1. Pulling a branch named "lite" is not how you get
# the lite site; without the flag you will see the full workspace instead.

# Reduced-feature build: hides referral seasons, the loyalty analytics block,
# and the referral half of Promo Codes & Referral.
# VITE_LITE_MODE=1

# Public-site build: "/" becomes the company page rather than the workspace,
# so the public domain never opens on a login screen.
# VITE_PUBLIC_SITE=1
